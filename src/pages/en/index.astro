---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/home/HomePage.astro';
import { faqEntries, featuredFaqIds } from '../../data/faq';
import { faqPageNode } from '../../lib/schema';
import { localizedPath, t } from '../../i18n';

const copy = t('en').pages.home;
const faq = faqPageNode({ path: localizedPath('home', 'en'), locale: 'en' }, faqEntries(featuredFaqIds, 'en'), Astro.site);
---

<BaseLayout title={copy.title} description={copy.description} locale="en" routeKey="home" schema={[faq]}>
  <HomePage locale="en" />
</BaseLayout>
