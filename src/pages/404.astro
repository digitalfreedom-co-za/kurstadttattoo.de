---
// One 404 for both locales (GitHub Pages serves a single 404.html): German first, English below, both in
// the shared container, type scale and button style of the site.
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import Button from '../components/ui/Button.astro';
import { t, localizedPath } from '../i18n';

const de = t('de').pages.notFound;
const en = t('en').pages.notFound;
---

<BaseLayout title={de.title} description={de.description} locale="de" noindex>
  <Container class="py-section">
    <span class="basin-rule text-ink" aria-hidden="true"></span>
    <section class="mt-8 max-w-[40rem]" aria-labelledby="nicht-gefunden">
      <h1 id="nicht-gefunden" class="text-h1">{de.heading}</h1>
      <p class="mt-6 text-lead text-muted">{de.text}</p>
      <Button href={localizedPath('home', 'de')} class="mt-8">{de.homeLink}</Button>
    </section>
    <section lang="en" class="mt-14 max-w-[40rem] border-t border-line pt-10" aria-labelledby="not-found">
      <h2 id="not-found" class="text-h2">{en.heading}</h2>
      <p class="mt-6 text-muted">{en.text}</p>
      <Button href={localizedPath('home', 'en')} variant="secondary" class="mt-8">{en.homeLink}</Button>
    </section>
  </Container>
</BaseLayout>
