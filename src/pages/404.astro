---
// One 404 for both locales (GitHub Pages serves a single 404.html): German first, English below.
import BaseLayout from '../layouts/BaseLayout.astro';
import { t, localizedPath } from '../i18n';
import { url } from '../lib/url';

const de = t('de').pages.notFound;
const en = t('en').pages.notFound;
---

<BaseLayout title={de.title} description={de.description} locale="de" noindex>
  <section class="mx-auto max-w-2xl px-5 py-16 sm:py-24">
    <h1 class="text-4xl font-semibold tracking-tight">{de.heading}</h1>
    <p class="mt-4">{de.text}</p>
    <p class="mt-4"><a class="underline underline-offset-4" href={url(localizedPath('home', 'de'))}>{de.homeLink}</a></p>
    <div lang="en" class="mt-12">
      <h2 class="text-2xl font-semibold">{en.heading}</h2>
      <p class="mt-4">{en.text}</p>
      <p class="mt-4">
        <a class="underline underline-offset-4" hreflang="en" href={url(localizedPath('home', 'en'))}>{en.homeLink}</a>
      </p>
    </div>
  </section>
</BaseLayout>
