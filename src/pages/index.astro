---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/home/HomePage.astro';
import { faqEntries, featuredFaqIds } from '../data/faq';
import { faqPageNode } from '../lib/schema';
import { localizedPath, t } from '../i18n';

const copy = t('de').pages.home;
const faq = faqPageNode({ path: localizedPath('home', 'de'), locale: 'de' }, faqEntries(featuredFaqIds, 'de'), Astro.site);
---

<BaseLayout title={copy.title} description={copy.description} locale="de" routeKey="home" schema={[faq]}>
  <HomePage locale="de" />
</BaseLayout>
