---
// Hygiene page for both locales. Only stated facts: hygiene as a core value since the founding, the
// three standards, modern and well equipped rooms, what the studio photos show, and hygiene during
// healing from the old aftercare page. The working photo leads (archive photos, never labelled as the new
// studio), the three standards sit beside it in short. Procedures and certifications stay out until Patrick confirms them.
import SubpageLayout from '../../layouts/SubpageLayout.astro';
import Section from '../ui/Section.astro';
import ArtImage from '../ui/ArtImage.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { studio, phoneDisplay } from '../../config/site';
import { pageExists } from '../../lib/pages';
import { localizedPath, t, type Locale } from '../../i18n';

import patrickAtWork from '../../assets/images/patrick-wolf-beim-taetowieren-breit.jpg';
import patrickWorkstation from '../../assets/images/patrick-wolf-sitzend-lachend-breit.jpg';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const copy = dict.pages.hygiene;
const aftercareHref = pageExists('aftercare', locale) ? localizedPath('aftercare', locale) : undefined;
const [atWork, workstation] = copy.studio.figures;
---

<SubpageLayout locale={locale} routeKey="hygiene" related={['aftercare', 'consultation', 'faq']}>
  <!-- The working photo leads; the three standards follow beside it in short, instead of a section of their own. -->
  <Section id={copy.studio.id} eyebrow={copy.studio.eyebrow} title={copy.studio.title} intro={copy.studio.intro}>
    <div class="grid gap-10 md:grid-cols-12 md:gap-x-8">
      <figure class="min-w-0 md:col-span-7">
        <ArtImage
          src={patrickAtWork}
          alt={copy.imageAlt}
          ratio={4 / 3}
          crops={[{ media: '(min-width: 48rem)', ratio: 16 / 10 }]}
          position="right"
          widths={[480, 720, 1120]}
          sizes="(min-width: 84rem) 46rem, (min-width: 48rem) 58vw, 100vw"
        />
        <figcaption class="caption mt-3 border-t border-line pt-2">{atWork.caption}</figcaption>
      </figure>
      <div class="flex min-w-0 flex-col gap-8 md:col-span-5">
        <section id={copy.value.id} aria-labelledby={`${copy.value.id}-titel`}>
          <h3 id={`${copy.value.id}-titel`} class="font-display text-h4">{copy.value.title}</h3>
          <p class="mt-2 text-muted">{copy.value.intro}</p>
          <dl class="mt-4 border-t border-ink" data-reveal-group>
            {
              copy.value.items.map((item) => (
                <div class="border-b border-line py-3" data-reveal>
                  <dt class="font-semibold">{item.title}</dt>
                  <dd class="text-sm text-muted">{item.text}</dd>
                </div>
              ))
            }
          </dl>
        </section>
        <figure>
          <ArtImage
            src={patrickWorkstation}
            alt={workstation.alt ?? ''}
            ratio={4 / 3}
            position="center"
            widths={[420, 640, 920]}
            sizes="(min-width: 84rem) 32rem, (min-width: 48rem) 40vw, 100vw"
          />
          <figcaption class="caption mt-3 border-t border-line pt-2">{workstation.caption}</figcaption>
        </figure>
        <p class="flex gap-3 border-t border-ink pt-5" data-reveal>
          <Icon name="dialog" size={20} class="mt-0.5 shrink-0 text-neon" />
          <span>{copy.studio.questions}</span>
        </p>
        <Button href={studio.phone.href} icon="phone" class="self-start">
          {dict.cta.callPrefix}: {phoneDisplay(locale)}
        </Button>
      </div>
    </div>
  </Section>

  <Section id={copy.healing.id} eyebrow={copy.healing.eyebrow} title={copy.healing.title} intro={copy.healing.intro} tone="deep">
    <div class="grid gap-10 md:grid-cols-12 md:gap-x-8">
      <ul class="min-w-0 border-t border-ink md:col-span-7" data-reveal-group>
        {
          copy.healing.items.map((item) => (
            <li class="flex gap-4 border-b border-line py-4" data-reveal>
              <Icon name="drop" size={20} class="mt-0.5 shrink-0 text-neon" />
              <span>{item}</span>
            </li>
          ))
        }
      </ul>
      <div class="min-w-0 md:col-span-4 md:col-start-9">
        <aside class="border border-ink bg-wall p-6" aria-labelledby="arzt-titel" data-reveal>
          <h3 id="arzt-titel" class="flex items-center gap-3 font-display text-lg font-semibold">
            <Icon name="alert" size={22} class="shrink-0 text-neon" />
            {copy.healing.warningTitle}
          </h3>
          <p class="mt-3 text-muted">{copy.healing.warning}</p>
        </aside>
        {aftercareHref && <Button href={aftercareHref} variant="secondary" class="mt-6">{copy.healing.link}</Button>}
      </div>
    </div>
  </Section>
</SubpageLayout>
