---
// Privacy policy for both locales. Describes only what the site really does: GitHub Pages hosting, self
// hosted fonts, no cookies of its own, the three storage entries (consent record in localStorage, theme
// and explicit language in sessionStorage) and the cookies per vendor, both tables in the structure of the legal cookie policy, the
// cal.com calendar only after consent and only while the build embeds one (BookingPrivacy, wording per
// CAL_ENABLED and CAL_IS_DEMO), GA4 only while a measurement ID is configured (src/config/analytics.ts),
// contact by phone and the WEB.DE mailbox, plain external links. Controller from the imprint of the old site (operator in src/config/site.ts).
// Update this page whenever a third party service or a storage key is added or removed, and raise the
// consent version (src/config/consent.ts) when the consent text changes in substance.
// The consent dialog does not open by itself here (ConsentDialog, routeKey privacy), so the page stays
// readable before a decision.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../ui/PageHeader.astro';
import Container from '../ui/Container.astro';
import BookingPrivacy from '../legal/BookingPrivacy.astro';
import DataTable from '../legal/DataTable.astro';
import LegalProse from '../legal/LegalProse.astro';
import { BOOKING_PRIVACY_ANCHOR, CAL_ENABLED } from '../../config/booking';
import { ANALYTICS_ENABLED, GA4_COOKIE_MONTHS } from '../../config/analytics';
import { CONSENT_ANCHOR, CONSENT_CATEGORIES, CONSENT_STORAGE_KEY } from '../../config/consent';
import { operator, studio, phoneDisplay } from '../../config/site';
import { localizedPath, t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale);
const copy = dict.pages.privacy;
const breadcrumbs = [
  { name: dict.nav.items.home, path: localizedPath('home', locale) },
  { name: dict.nav.items.privacy, path: localizedPath('privacy', locale) },
];
const withOperator = (text: string) => text.replaceAll('{operator}', operator.name);
const external = { target: '_blank', rel: 'noopener noreferrer' } as const;
// Text variants for the services this build embeds: with calendar and statistics, with only one of them,
// or with none, in which case nothing asks for consent and the consent record is never written.
const consentNeeded = CONSENT_CATEGORIES.length > 0;
const description = CAL_ENABLED ? copy.description : copy.descriptionNoCalendar;
const lead = CAL_ENABLED
  ? ANALYTICS_ENABLED ? copy.leadAnalytics : copy.lead
  : ANALYTICS_ENABLED ? copy.leadAnalyticsNoCalendar : copy.leadNoCalendar;
const noTracking = CAL_ENABLED
  ? ANALYTICS_ENABLED ? copy.storage.noTrackingAnalytics : copy.storage.noTracking
  : ANALYTICS_ENABLED ? copy.storage.noTrackingAnalyticsNoCalendar : copy.storage.noTrackingNoCalendar;
const consentIntro = CAL_ENABLED
  ? ANALYTICS_ENABLED ? copy.consent.introAnalytics : copy.consent.intro
  : ANALYTICS_ENABLED ? copy.consent.introAnalyticsNoCalendar : copy.consent.introNoCalendar;
const { writtenNoCalendar, ...consentRow } = copy.storage.rows.consent;
// Section 3.5 of the cookie policy template (legal website/COOKIE_POLICY.en.md): every key the site's own
// code writes, each written only on the visitor's own action. The consent record is kept in localStorage,
// theme and language choice only for the tab in sessionStorage (Decision Log #33).
const storageColumns = Object.values(copy.storage.columns);
const ownEntry = (key: string, where: string, row: { written: string; purpose: string; duration: string }) => [
  key,
  where,
  row.written,
  row.purpose,
  copy.storage.categoryNecessary,
  row.duration,
  copy.storage.necessary,
];
const storageRows = [
  ...(consentNeeded
    ? [ownEntry(CONSENT_STORAGE_KEY, copy.storage.where, { ...consentRow, written: CAL_ENABLED ? consentRow.written : writtenNoCalendar })]
    : []),
  ownEntry('theme', copy.storage.whereSession, copy.storage.rows.theme),
  ownEntry('locale-explicit', copy.storage.whereSession, copy.storage.rows.locale),
];
// Section 5.1 of the template: cookies of the embedded vendors, one row per service this build embeds.
const vendors = copy.storage.vendors;
type VendorRow = { vendor: string; purpose: string; type: string; category: string; retention: string };
const vendorEntry = (cookie: string, row: VendorRow) => [
  row.vendor,
  cookie,
  row.purpose,
  row.type,
  row.category,
  row.retention,
  vendors.consent,
];
const vendorRows = [
  ...(CAL_ENABLED ? [vendorEntry('__cf_bm', vendors.rows.booking)] : []),
  ...(ANALYTICS_ENABLED
    ? [
        vendorEntry(vendors.rows.analytics.cookie, {
          ...vendors.rows.analytics,
          retention: vendors.rows.analytics.retention.replaceAll('{months}', String(GA4_COOKIE_MONTHS)),
        }),
      ]
    : []),
];

const toc = [
  { id: 'verantwortlicher', label: copy.controller.title },
  { id: 'hosting', label: copy.hosting.title },
  { id: 'speicher', label: copy.storage.title },
  { id: CONSENT_ANCHOR, label: copy.consent.title },
  { id: BOOKING_PRIVACY_ANCHOR, label: dict.privacyBooking.title },
  ...(ANALYTICS_ENABLED ? [{ id: 'statistik', label: copy.analytics.title }] : []),
  { id: 'kontakt', label: copy.contact.title },
  { id: 'links', label: copy.links.title },
  { id: 'rechte', label: copy.rights.title },
  { id: 'beschwerde', label: copy.complaint.title },
  { id: 'pflicht', label: copy.duty.title },
];
---

<BaseLayout title={copy.title} description={description} locale={locale} routeKey="privacy" breadcrumbs={breadcrumbs}>
  <PageHeader
    locale={locale}
    breadcrumbs={breadcrumbs}
    eyebrow={copy.eyebrow}
    heading={copy.heading}
    lead={lead}
  />

  <Container class="py-14 md:py-20">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-x-8">
      <nav class="min-w-0 lg:col-span-3" aria-label={copy.tocNavLabel}>
        <div class="lg:sticky lg:top-[calc(var(--header-height)+2rem)]">
          <p class="label text-muted">{copy.tocLabel}</p>
          <ul class="mt-2 grid border-t border-ink">
            {
              toc.map((item) => (
                <li class="border-b border-line">
                  <a class="link inline-flex min-h-11 items-center py-1 text-sm no-underline hover:underline" href={`#${item.id}`}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="mt-4 text-sm text-muted">{copy.updated}</p>
        </div>
      </nav>

      <LegalProse class="lg:col-span-8 lg:col-start-5">
        <h2 id="verantwortlicher">{copy.controller.title}</h2>
        <p>{copy.controller.intro}</p>
        <p>
          {operator.name}<br />
          {operator.street}<br />
          {operator.postalCode} {operator.city}<br />
          {dict.studio.country}<br />
          {copy.controller.represented.replaceAll('{name}', operator.managingDirector)}
        </p>
        <p>
          {dict.studio.phoneLabel}: <a href={studio.phone.href}>{phoneDisplay(locale)}</a><br />
          {dict.studio.emailLabel}: <a class="break-all" href={studio.email.href}>{studio.email.display}</a>
        </p>
        <p>{copy.controller.questions}</p>

        <h2 id="hosting">{copy.hosting.title}</h2>
        <p>{copy.hosting.provider}</p>
        <p>{copy.hosting.logs}</p>
        <p>{copy.hosting.basis}</p>
        <p>
          {copy.hosting.transfer}
          <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement" {...external}>
            {copy.hosting.privacyLink}<span class="sr-only"> {copy.newWindow}</span></a
          >.
        </p>
        <p>{copy.hosting.https}</p>

        <h2 id="speicher">{copy.storage.title}</h2>
        <p>{copy.storage.fonts}</p>
        <h3 id="speicher-eigene">{copy.storage.ownTitle}</h3>
        <p>{copy.storage.entries}</p>
        <DataTable
          id="speicher"
          label={copy.storage.tableLabel}
          scrollHint={copy.storage.scrollHint}
          columns={storageColumns}
          rows={storageRows}
        />
        <p>{copy.storage.basis}</p>

        <h3 id="cookies-anbieter">{vendors.title}</h3>
        {
          vendorRows.length > 0 ? (
            <>
              <p>{vendors.intro}</p>
              <DataTable
                id="cookies-anbieter"
                label={vendors.tableLabel}
                scrollHint={copy.storage.scrollHint}
                columns={Object.values(vendors.columns)}
                rows={vendorRows}
                codeColumn={1}
              />
            </>
          ) : (
            <p>{vendors.none}</p>
          )
        }
        <p>{noTracking}</p>

        <h2 id={CONSENT_ANCHOR}>{copy.consent.title}</h2>
        <p>{consentIntro}</p>
        {
          consentNeeded && (
            <>
              <p>{copy.consent.record.replaceAll('{key}', CONSENT_STORAGE_KEY)}</p>
              <p>
                {copy.consent.withdraw}
                <a href={`#${CONSENT_ANCHOR}`} data-consent-open aria-haspopup="dialog">{copy.consent.withdrawLink}</a>. {
                  CAL_ENABLED ? copy.consent.withdrawRest : copy.consent.withdrawRestNoCalendar
                }
              </p>
            </>
          )
        }

        <BookingPrivacy locale={locale} />

        {
          ANALYTICS_ENABLED && (
            <>
              <h2 id="statistik">{copy.analytics.title}</h2>
              <p>{copy.analytics.provider}</p>
              <p>{copy.analytics.data.replaceAll('{months}', String(GA4_COOKIE_MONTHS))}</p>
              <p>{copy.analytics.consentMode}</p>
              <p>{copy.analytics.basis}</p>
              <p>
                {copy.analytics.transfer}
                <a href="https://policies.google.com/privacy" {...external}>
                  {copy.analytics.privacyLink}<span class="sr-only"> {copy.newWindow}</span></a
                >.
              </p>
            </>
          )
        }

        <h2 id="kontakt">{copy.contact.title}</h2>
        <p>{copy.contact.data}</p>
        <p>{copy.contact.mailbox}</p>
        <p>{copy.contact.retention}</p>

        <h2 id="links">{copy.links.title}</h2>
        <p>{copy.links.text}</p>

        <h2 id="rechte">{copy.rights.title}</h2>
        <p>{withOperator(copy.rights.intro)}</p>
        <ul>
          {copy.rights.items.map((item) => <li>{item}</li>)}
        </ul>
        <p>
          {copy.rights.request} <a class="break-all" href={studio.email.href}>{studio.email.display}</a>
        </p>
        <h3>{copy.rights.objectionTitle}</h3>
        <p>{copy.rights.objection}</p>

        <h2 id="beschwerde">{copy.complaint.title}</h2>
        <p>{withOperator(copy.complaint.text)}</p>
        <p>
          <a href="https://datenschutz.hessen.de" {...external}>
            datenschutz.hessen.de<span class="sr-only"> {copy.newWindow}</span></a
          >
        </p>

        <h2 id="pflicht">{copy.duty.title}</h2>
        <p>{copy.duty.text}</p>
      </LegalProse>
    </div>
  </Container>
</BaseLayout>
