---
// Site footer on the always dark surface: the full logo, the studio (new address, phone, email),
// opening hours (the closure first, then the previous hours until the new location confirms them), TikTok,
// the pages, the secondary link to Patrick Wolf's expert office and the legal links. Only pages that exist are linked (src/lib/pages.ts).
import Logo from '../../assets/brand/logo.svg';
import Container from '../ui/Container.astro';
import Icon from '../ui/Icon.astro';
import { expertSite, footerNav, legalNav, reopening, studio, phoneDisplay } from '../../config/site';
import { CONSENT_ANCHOR } from '../../config/consent';
import { existingRoutes, pageExists } from '../../lib/pages';
import { localizedPath, t, type Locale } from '../../i18n';
import { url } from '../../lib/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const pages = existingRoutes(footerNav, locale);
const legal = existingRoutes(legalNav, locale);
const { address } = studio;
const linkClass = 'link inline-flex min-h-11 items-center no-underline hover:underline';
// Cookie settings open the consent dialog. Without JS the link leads to the consent section of the
// privacy policy; while that page is not built yet, the control is a button shown only with JS.
const consentHref = pageExists('privacy', locale) ? url(`${localizedPath('privacy', locale)}#${CONSENT_ANCHOR}`) : undefined;
---

<footer class="bg-night text-chalk" data-inert-when-menu>
  <!-- A thin line, not the basin rule: the closing band above already opens with it. Studio facts sit
       together (address, contact, hours); the pages run in two columns, so they no longer set the height. -->
  <Container class="pt-10 md:pt-14">
    <div class="grid gap-10 border-t border-chalk/15 pt-10 sm:grid-cols-2 md:pt-12 lg:grid-cols-12 lg:gap-x-8">
      <div class="min-w-0 lg:col-span-3">
        <Logo class="h-auto w-36 md:w-44" role="img" aria-label={studio.name} />
        <p class="mt-6 max-w-[22rem] text-sm text-chalk-muted">{copy.footer.about}</p>
        <p class="label mt-6 text-chalk-muted">{copy.studio.followLabel}</p>
        <p class="mt-1">
          <a class={`${linkClass} items-start gap-3 py-2 text-[0.9375rem]`} href={studio.tiktok.href} rel="noopener" target="_blank">
            <Icon name="tiktok" size={18} class="mt-1 shrink-0 text-neon-glow" />
            <span>{copy.studio.tiktok}<span class="block text-sm text-chalk-muted">{studio.tiktok.handle}</span></span>
          </a>
        </p>
      </div>

      <div class="min-w-0 lg:col-span-4">
        <p class="label text-chalk-muted">{copy.studio.addressLabel}</p>
        <address class="mt-3 grid gap-1 text-[0.9375rem] not-italic">
          <p class="flex gap-3">
            <Icon name="pin" size={18} class="mt-1 shrink-0 text-neon-glow" />
            <span>
              {address.street}
              <br />
              {`${address.postalCode} ${address.city}`}
              {reopening.active && <span class="mt-1 block text-sm text-chalk-muted">{copy.studio.newAddressNote}</span>}
            </span>
          </p>
          <p>
            <a class={`${linkClass} gap-3`} href={studio.phone.href}>
              <Icon name="phone" size={18} class="shrink-0 text-neon-glow" />
              <span><span class="sr-only">{copy.studio.phoneLabel} </span>{phoneDisplay(locale)}</span>
            </a>
          </p>
          <p>
            <a class={`${linkClass} gap-3 break-all`} href={studio.email.href}>
              <Icon name="mail" size={18} class="shrink-0 text-neon-glow" />
              <span><span class="sr-only">{copy.studio.emailLabel} </span>{studio.email.display}</span>
            </a>
          </p>
        </address>
        <p class="label mt-6 text-chalk-muted">{copy.studio.hoursLabel}</p>
        <p class="mt-3 flex gap-3 text-[0.9375rem]">
          <Icon name="clock" size={18} class="mt-1 shrink-0 text-neon-glow" />
          <span>
            {reopening.active && <span class="mb-1 block font-semibold">{copy.studio.closedNote}</span>}
            {copy.studio.hours}<span class="block text-sm text-chalk-muted">{copy.studio.hoursNote}</span>
            <span class="mt-2 block text-sm text-chalk-muted">{copy.studio.hoursUnconfirmed}</span>
          </span>
        </p>
      </div>

      <div class="min-w-0 sm:col-span-2 lg:col-span-5">
        {
          pages.length > 0 && (
            <nav aria-label={copy.nav.footerLabel} class="mb-8">
              <p class="label text-chalk-muted">{copy.nav.footerLabel}</p>
              <ul class="mt-2 grid grid-cols-2 gap-x-6 text-[0.9375rem]">
                {pages.map((key) => (
                  <li>
                    <a class={linkClass} href={url(localizedPath(key, locale))}>
                      {copy.nav.items[key]}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )
        }
        <p class="label text-chalk-muted">{copy.footer.expertLabel}</p>
        <p class="mt-3 max-w-[26rem] text-sm text-chalk-muted">
          {copy.footer.expertText}{' '}
          <a class="link inline-flex items-center gap-1 font-semibold text-chalk" href={expertSite.href} rel="noopener">
            {expertSite.display}
            <Icon name="external" size={14} class="shrink-0" />
          </a>
        </p>
      </div>
    </div>
  </Container>

  <Container>
    <div class="mt-12 flex flex-col gap-2 border-t border-chalk/15 py-4 text-sm text-chalk-muted sm:flex-row sm:items-center sm:justify-between">
      <p>&copy; {copy.footer.copyright}</p>
      <nav aria-label={copy.nav.legalLabel}>
        <ul class="flex flex-wrap gap-x-6">
          {legal.map((key) => (
            <li>
              <a class={linkClass} href={url(localizedPath(key, locale))}>
                {copy.nav.items[key]}
              </a>
            </li>
          ))}
          <li class:list={[!consentHref && 'consent-open-js']}>
            {
              consentHref ? (
                <a class={linkClass} href={consentHref} data-consent-open aria-haspopup="dialog">
                  {copy.footer.cookieSettings}
                </a>
              ) : (
                <button type="button" class={`${linkClass} cursor-pointer`} data-consent-open aria-haspopup="dialog">
                  {copy.footer.cookieSettings}
                </button>
              )
            }
          </li>
        </ul>
      </nav>
    </div>
  </Container>
</footer>

<style>
  /* The button form of the cookie settings does nothing without JS, so it only shows with JS. */
  :global(html:not(.js)) .consent-open-js {
    display: none;
  }
</style>
