---
// Header mark: the fountain from the studio logo (traced from docs/source-content/images/
// logo-kurstadttattoo-schwarz.png, lettering removed) plus a typeset wordmark. The full logo with its
// lettering is too fine below 60px; it appears large in the footer. Below 360px only the mark, so the
// four header controls keep their row; the link's accessible name carries the studio name.
import FountainMark from '../../assets/brand/fountain-mark.svg';
import { localizedPath, t, type Locale } from '../../i18n';
import { url } from '../../lib/url';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<a
  href={url(localizedPath('home', locale))}
  class="group/logo inline-flex min-h-11 min-w-11 shrink-0 items-center gap-2.5 rounded-xs"
  aria-label={t(locale).nav.logoLabel}
>
  <FountainMark class="h-7 w-auto shrink-0 transition-colors duration-300 group-hover/logo:text-neon md:h-8" aria-hidden="true" focusable="false" />
  <span class="hidden flex-col leading-none min-[360px]:flex">
    <span class="font-display text-[0.9375rem] font-bold tracking-[-0.01em] min-[400px]:text-base md:text-lg">KurstadtTattoo</span>
    <span class="label mt-1 text-[0.625rem] tracking-[0.2em] text-muted">Bad Nauheim</span>
  </span>
</a>
