---
// Temporary start page content for both locales, until the landing page ticket (#5) replaces it.
import Container from './Container.astro';
import ReopeningNotice from './ReopeningNotice.astro';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale).pages.home;
---

<Container class="py-section">
  <span class="basin-rule max-w-[40rem]" data-reveal="rule" aria-hidden="true"></span>
  <h1 class="mt-8 max-w-[14ch] text-h1">{copy.heading}</h1>
  <p class="mt-6 max-w-[38rem] text-lead text-muted" data-reveal>{copy.intro}</p>
  <p class="label mt-6 text-muted" data-reveal>{copy.status}</p>
  <ReopeningNotice locale={locale} class="mt-12 md:mt-16" />
</Container>
