---
// Temporary start page content for both locales, until the landing page ticket (#5) replaces it.
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
}

const copy = t(Astro.props.locale).pages.home;
---

<section class="mx-auto max-w-2xl px-5 py-16 sm:py-24">
  <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">{copy.heading}</h1>
  <p class="mt-6 text-lg leading-relaxed">{copy.intro}</p>
  <p class="mt-4 text-base opacity-75">{copy.status}</p>
</section>
