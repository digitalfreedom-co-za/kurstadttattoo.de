---
// Card set like a work on a gallery wall: an optional picture, then the wall label (kicker, title, text).
// With href the whole card is clickable; the title link carries the accessible name. Never numbered.
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { url } from '../../lib/url';

interface Props {
  kicker?: string;
  title: string;
  href?: string;
  linkLabel?: string;
  image?: { src: ImageMetadata; alt: string };
  /** Aspect ratio of the picture as width / height. */
  ratio?: number;
  headingLevel?: 'h3' | 'h4';
  class?: string;
}

const { kicker, title, href, linkLabel, image, ratio = 4 / 5, headingLevel: Heading = 'h3', class: className } = Astro.props;
const resolvedHref = href?.startsWith('/') ? url(href) : href;
---

<article class:list={['group/card relative flex h-full min-w-0 flex-col', className]} data-reveal>
  {
    image && (
      <div class="relative mb-5 overflow-hidden bg-wall-deep" style={`aspect-ratio:${ratio}`}>
        <Image
          src={image.src}
          alt={image.alt}
          widths={[360, 560, 800]}
          sizes="(min-width: 64rem) 28rem, (min-width: 40rem) 45vw, 100vw"
          class="size-full object-cover transition-transform duration-700 ease-out-quint group-hover/card:scale-[1.03]"
        />
      </div>
    )
  }
  <div class="flex flex-1 flex-col border-t border-ink pt-4">
    {kicker && <p class="label text-muted">{kicker}</p>}
    <Heading
      class:list={[
        kicker && 'mt-3',
        Heading === 'h3' ? 'text-h3' : 'text-h4',
        resolvedHref && 'transition-colors group-hover/card:text-neon group-has-[a:focus-visible]/card:text-neon',
      ]}
    >
      {
        resolvedHref ? (
          <a
            href={resolvedHref}
            class="after:absolute after:inset-0 focus-visible:outline-none focus-visible:after:outline-2 focus-visible:after:outline-offset-4 focus-visible:after:outline-neon"
          >
            {title}
          </a>
        ) : (
          title
        )
      }
    </Heading>
    {
      Astro.slots.has('default') && (
        <div class="mt-3 text-muted">
          <slot />
        </div>
      )
    }
    {
      resolvedHref && linkLabel && (
        <p class="mt-auto pt-5 text-sm font-semibold" aria-hidden="true">
          <span class="border-b border-current/40 transition-colors group-hover/card:border-neon group-hover/card:text-neon">
            {linkLabel}
          </span>
        </p>
      )
    }
  </div>
</article>
