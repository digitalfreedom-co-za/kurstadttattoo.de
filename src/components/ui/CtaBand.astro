---
// Closing call to action on the always dark surface (the counter): statement left, the action right.
// Default action is the booking page; the phone number and the email stay as quiet alternative lines.
// The booking page itself passes primary="phone", so its closing call offers the direct way instead.
import Container from './Container.astro';
import Button from './Button.astro';
import { studio } from '../../config/site';
import { localizedPath, t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  title: string;
  text?: string;
  primary?: 'booking' | 'phone';
}

const { locale, title, text, primary = 'booking' } = Astro.props;
const dict = t(locale);
const copy = dict.cta;
const altLinkClass = 'link inline-flex min-h-11 items-center font-semibold break-all';
---

<section class="bg-night pt-section pb-16 text-chalk md:pb-20" aria-label={copy.label}>
  <Container>
    <span class="basin-rule text-chalk/40" data-reveal="rule" aria-hidden="true"></span>
    <div class="mt-10 grid gap-10 md:mt-14 md:grid-cols-12 md:gap-x-8">
      <div class="min-w-0 md:col-span-7">
        <h2 class="text-h2">{title}</h2>
        {text && <p class="mt-6 max-w-[34rem] text-lead text-chalk-muted" data-reveal>{text}</p>}
      </div>
      <div class="flex min-w-0 flex-col gap-4 md:col-span-4 md:col-start-9 md:justify-end">
        {
          primary === 'booking' ? (
            <Button href={localizedPath('booking', locale)} variant="inverse" icon="calendar" class="self-start">
              {dict.booking.label}
            </Button>
          ) : (
            <Button href={studio.phone.href} variant="inverse" icon="phone" class="self-start">
              <span class="sr-only">{copy.callPrefix}: </span>
              {studio.phone.display}
            </Button>
          )
        }
        <ul class="text-sm">
          {
            primary === 'booking' && (
              <li>
                <a class={altLinkClass} href={studio.phone.href}>
                  {copy.callPrefix}: {studio.phone.display}
                </a>
              </li>
            )
          }
          <li>
            <a class={altLinkClass} href={studio.email.href}>
              {copy.emailLink}
            </a>
          </li>
        </ul>
      </div>
    </div>
  </Container>
</section>
