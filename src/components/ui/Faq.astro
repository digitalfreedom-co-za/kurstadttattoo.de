---
// FAQ in two forms. accordion: native details/summary, works without JS, keyboard and screen reader
// friendly. list: every answer visible under a real heading, for the FAQ page, where readers scan and
// crawlers should not meet collapsed text. Answers may contain trusted inline HTML from our own
// dictionaries (links, emphasis), never user input.
export interface FaqEntry {
  question: string;
  answer: string;
}

interface Props {
  items: FaqEntry[];
  variant?: 'accordion' | 'list';
  /** Same name on all items makes them exclusive (one open at a time) in supporting browsers. */
  name?: string;
  class?: string;
}

const { items, variant = 'accordion', name, class: className } = Astro.props;
---

{
  variant === 'list' ? (
    <div class:list={['border-t border-ink', className]} data-reveal-group>
      {items.map((item) => (
        <article class="grid gap-3 border-b border-line py-6 md:grid-cols-12 md:gap-x-8 md:py-8" data-reveal>
          <h3 class="font-sans text-h4 md:col-span-5">{item.question}</h3>
          <p class="max-w-[40rem] text-muted md:col-span-7" set:html={item.answer} />
        </article>
      ))}
    </div>
  ) : (
    <div class:list={['border-t border-ink', className]} data-reveal-group>
      {items.map((item) => (
        <details class="group/faq border-b border-line" name={name} data-reveal>
          <summary class="flex min-h-11 cursor-pointer list-none items-start gap-4 py-5 md:gap-8 md:py-6 [&::-webkit-details-marker]:hidden">
            <span class="flex-1 text-h4 font-semibold transition-colors group-hover/faq:text-neon">{item.question}</span>
            <span class="relative mt-1.5 size-4 shrink-0" aria-hidden="true">
              <span class="absolute top-1/2 left-0 h-px w-4 bg-current" />
              <span class="absolute top-0 left-1/2 h-4 w-px bg-current transition-transform duration-300 group-open/faq:scale-y-0" />
            </span>
          </summary>
          <div class="pb-7 text-muted">
            <p class="max-w-[40rem]" set:html={item.answer} />
          </div>
        </details>
      ))}
    </div>
  )
}
