---
// Breadcrumb trail of a subpage: home, then the page. The last crumb is the current page and stays
// unlinked. The same trail feeds the BreadcrumbList in the JSON-LD (SeoHead).
import type { Crumb } from '../../lib/schema';
import { url } from '../../lib/url';
import { t, type Locale } from '../../i18n';

interface Props {
  items: Crumb[];
  locale: Locale;
  class?: string;
}

const { items, locale, class: className } = Astro.props;
---

<nav aria-label={t(locale).breadcrumb.label} class:list={['label text-muted', className]}>
  <ol class="flex flex-wrap items-center gap-x-3">
    {
      items.map((item, index) =>
        index === items.length - 1 ? (
          <li class="flex items-center">
            <span aria-current="page" class="inline-flex min-h-11 items-center text-ink">{item.name}</span>
          </li>
        ) : (
          <li class="flex items-center gap-3">
            <a class="inline-flex min-h-11 items-center no-underline transition-colors hover:text-neon" href={url(item.path)}>
              {item.name}
            </a>
            <span class="h-[3px] w-3 bg-neon" aria-hidden="true" />
          </li>
        ),
      )
    }
  </ol>
</nav>
