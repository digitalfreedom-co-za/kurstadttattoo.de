---
// Process in real sequence (consultation, design, session, aftercare): the only place where numbers
// appear. A thin line joins the steps; on wide screens the steps run side by side.
import { t, type Locale } from '../../i18n';

export interface Step {
  title: string;
  text: string;
}

interface Props {
  steps: Step[];
  locale: Locale;
  class?: string;
}

const { steps, locale, class: className } = Astro.props;
const prefix = t(locale).steps.stepPrefix;
const columns = steps.length >= 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3';
---

<ol class:list={['grid gap-0 lg:gap-x-8', columns, className]} data-reveal-group>
  {
    steps.map((step, index) => (
      <li class="relative grid grid-cols-[3rem_minmax(0,1fr)] gap-x-4 pb-10 last:pb-0 lg:block lg:pb-0" data-reveal>
        {index < steps.length - 1 && (
          <span class="absolute top-12 bottom-0 left-6 w-px bg-line lg:top-6 lg:-right-6 lg:bottom-auto lg:left-16 lg:h-px lg:w-auto" aria-hidden="true" />
        )}
        <span
          class="relative flex size-12 items-center justify-center border border-ink bg-wall font-display text-xl leading-none font-semibold"
          aria-hidden="true"
        >
          {index + 1}
        </span>
        <div class="pt-2 lg:pt-6">
          <h3 class="font-sans text-h4">
            <span class="sr-only">{prefix} {index + 1}: </span>
            {step.title}
          </h3>
          <p class="mt-2 max-w-[30rem] text-muted">{step.text}</p>
        </div>
      </li>
    ))
  }
</ol>
