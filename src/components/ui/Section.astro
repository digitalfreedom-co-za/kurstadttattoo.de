---
// Page section. The opener is the basin rule from the logo, an eyebrow label and the heading; on wide
// screens the intro sits beside the heading like the text panel next to a picture. Below md everything
// stacks. density: chapter for the main parts of a page, support for short supporting blocks and groups
// within a chapter (gallery styles, related pages). Only chapters open with the basin rule, so the double
// rule marks a change of subject instead of every block; support blocks open with a thin line.
// tone: wall (page background), deep (a step darker wall), night (always dark, like the counter).
import Container from './Container.astro';
import Eyebrow from './Eyebrow.astro';

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  intro?: string;
  tone?: 'wall' | 'deep' | 'night';
  density?: 'chapter' | 'support';
  /** Heading level of the title in the page outline. */
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const {
  id,
  eyebrow,
  title,
  intro,
  tone = 'wall',
  density = 'chapter',
  headingLevel: Heading = 'h2',
  class: className,
} = Astro.props;

const support = density === 'support';
const headingId = id && title ? `${id}-titel` : undefined;
const hasHeader = Boolean(eyebrow || title || intro);
const night = tone === 'night';

const toneClass = {
  wall: 'bg-wall text-ink',
  deep: 'bg-wall-deep text-ink',
  night: 'bg-night text-chalk',
}[tone];
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={[support ? 'py-section-support' : 'py-section', toneClass, className]}
>
  <Container>
    {
      hasHeader && (
        <header>
          {support ? (
            <span class:list={['block h-px', night ? 'bg-chalk/25' : 'bg-line']} aria-hidden="true" />
          ) : (
            <span class:list={['basin-rule', night ? 'text-chalk/40' : 'text-ink']} data-reveal="rule" aria-hidden="true" />
          )}
          <div class:list={['grid gap-5 md:grid-cols-12 md:items-end md:gap-x-8', support ? 'mt-5 md:mt-6' : 'mt-6 md:mt-8']}>
            <div class="min-w-0 md:col-span-7">
              {eyebrow && <Eyebrow tone={night ? 'night' : 'wall'}>{eyebrow}</Eyebrow>}
              {title && (
                <Heading id={headingId} class:list={[eyebrow && 'mt-4', support ? 'text-h3' : 'text-h2']}>
                  {title}
                </Heading>
              )}
            </div>
            {intro && (
              <p
                class:list={[
                  'min-w-0 max-w-[36rem] md:col-span-5',
                  support ? '' : 'text-lead',
                  night ? 'text-chalk-muted' : 'text-muted',
                ]}
                data-reveal
              >
                {intro}
              </p>
            )}
          </div>
        </header>
      )
    }
    <div class:list={[hasHeader && (support ? 'mt-8 md:mt-10' : 'mt-10 md:mt-16')]}>
      <slot />
    </div>
  </Container>
</section>
