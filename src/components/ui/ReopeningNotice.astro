---
// The move to Friedrich-Ebert-Platz 1A. strip: one line above the header on every page while the
// reopening is active (src/config/site.ts). panel: the full notice with address and closing line, for the
// home and contact pages. Both render nothing once the reopening is switched off.
import Container from './Container.astro';
import Icon from './Icon.astro';
import { reopening, studio } from '../../config/site';
import { t, type Locale } from '../../i18n';

interface Props {
  locale: Locale;
  variant?: 'strip' | 'panel';
  /** Heading level of the panel title; h3 when the panel sits inside a titled section. */
  headingLevel?: 'h2' | 'h3';
  class?: string;
}

const { locale, variant = 'panel', headingLevel: Heading = 'h2', class: className } = Astro.props;
const copy = t(locale).reopening;
const { address } = studio;
---

{
  reopening.active &&
    (variant === 'strip' ? (
      <aside aria-label={copy.label} class:list={['bg-night text-chalk', className]}>
        <Container class="flex min-h-9 items-center gap-2.5 py-1.5 text-[0.8125rem] leading-snug">
          <span class="size-1.5 shrink-0 bg-neon-glow" aria-hidden="true" />
          <p>{copy.strip}</p>
        </Container>
      </aside>
    ) : (
      <aside
        aria-labelledby="neueroeffnung-titel"
        class:list={['relative overflow-hidden border border-ink bg-night text-chalk', className]}
        data-reveal
      >
        <div class="grid gap-8 p-6 sm:p-8 md:grid-cols-12 md:gap-x-8 md:p-10">
          <div class="min-w-0 md:col-span-7">
            <p class="label flex items-center gap-3 text-neon-glow">
              <span class="h-[3px] w-5 shrink-0 bg-neon-glow" aria-hidden="true" />
              {copy.label}
            </p>
            <Heading id="neueroeffnung-titel" class="mt-4 text-h3">
              {copy.title}
            </Heading>
            <p class="mt-4 max-w-[34rem] text-chalk-muted">{copy.text}</p>
          </div>
          <div class="flex min-w-0 flex-col justify-end gap-4 md:col-span-5">
            <address class="flex gap-3 not-italic">
              <Icon name="pin" size={20} class="mt-0.5 shrink-0 text-neon-glow" />
              <span>
                {address.street}
                <br />
                {`${address.postalCode} ${address.city}`}
              </span>
            </address>
            <p class="border-t border-chalk/20 pt-4 font-display text-lg">{copy.closing}</p>
          </div>
        </div>
      </aside>
    ))
}
