---
// SEO tags of a page: title, description, author, robots, canonical, hreflang alternates for both locales
// plus x-default, Open Graph and Twitter with the OG card of the page locale, the llms.txt hint and one
// JSON-LD @graph (site wide entities, the WebPage, its breadcrumb trail and the page's own nodes).
// Absolute URLs come from Astro.site plus the base path, indexing from the switch in config/site.ts.
import { getImage } from 'astro:assets';
import JsonLd from './JsonLd.astro';
import { site, studio, indexable, ogImage } from '../../config/site';
import { absoluteUrl, withoutBase } from '../../lib/url';
import { breadcrumbId, breadcrumbNode, siteGraph, webPageNode, type Crumb, type JsonLdNode } from '../../lib/schema';
import { defaultLocale, locales, localeMeta, localizedPath, t, type Locale, type RouteKey } from '../../i18n';
import portrait from '../../assets/images/patrick-wolf-arme-verschraenkt-neonlogo.jpg';

export interface SeoProps {
  title: string;
  description: string;
  locale: Locale;
  /** Route table entry of this page; pages outside the table (404) have no alternates. */
  routeKey?: RouteKey;
  /** Never index this page, whatever the switch says (404). */
  noindex?: boolean;
  /** Page specific JSON-LD nodes (e.g. FAQPage), appended to the @graph. */
  schema?: JsonLdNode[];
  /** Breadcrumb trail of a subpage (home first, this page last); adds the BreadcrumbList. */
  breadcrumbs?: Crumb[];
}

type Props = SeoProps;

const { title, description, locale, routeKey, noindex = false, schema = [], breadcrumbs = [] } = Astro.props;

const path = withoutBase(Astro.url.pathname);
const canonical = absoluteUrl(path, Astro.site);
const robots = noindex || !indexable ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1';
const alternates = routeKey
  ? locales.map((alt) => ({ hreflang: localeMeta[alt].lang, href: absoluteUrl(localizedPath(routeKey, alt), Astro.site) }))
  : [];
const image = absoluteUrl(ogImage.path[locale], Astro.site);
const imageAlt = t(locale).seo.ogImageAlt;
const llmsTxt = absoluteUrl(`${localizedPath('home', locale)}llms.txt`, Astro.site);

let graph: Record<string, unknown> | null = null;
if (!noindex) {
  const portraitImage = await getImage({ src: portrait, width: 800, format: 'jpeg' });
  const webPage = webPageNode({ path, name: title, description, locale, routeKey }, Astro.site);
  const trail = breadcrumbs.length > 0 ? [breadcrumbNode(path, breadcrumbs, Astro.site)] : [];
  if (trail.length > 0) webPage.breadcrumb = { '@id': breadcrumbId(path, Astro.site) };
  graph = {
    '@graph': [...siteGraph(Astro.site, locale, new URL(portraitImage.src, Astro.site).href), webPage, ...trail, ...schema],
  };
}
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="author" content={studio.artist} />
<meta name="robots" content={robots} />
{!noindex && <link rel="canonical" href={canonical} />}
{
  !noindex &&
    alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)
}
{
  !noindex && routeKey && (
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(localizedPath('home', defaultLocale), Astro.site)} />
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={localeMeta[locale].ogLocale} />
{
  locales
    .filter((alt) => alt !== locale)
    .map((alt) => <meta property="og:locale:alternate" content={localeMeta[alt].ogLocale} />)
}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
<meta property="og:image:alt" content={imageAlt} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />

<link rel="alternate" type="text/plain" title="llms.txt" href={llmsTxt} />
{graph && <JsonLd data={graph} />}
