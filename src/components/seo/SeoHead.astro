---
// SEO tags of a page: title, description, robots, canonical, hreflang alternates for both locales plus
// x-default, basic Open Graph and one JSON-LD @graph. Absolute URLs come from Astro.site plus the base
// path, indexing from the switch in config/site.ts. OG image, Twitter card and the full entity graph
// follow in the SEO ticket (#9).
import JsonLd from './JsonLd.astro';
import { site, indexable } from '../../config/site';
import { absoluteUrl, withoutBase } from '../../lib/url';
import { websiteNode, webPageNode } from '../../lib/schema';
import { defaultLocale, locales, localeMeta, localizedPath, type Locale, type RouteKey } from '../../i18n/routes';

export interface SeoProps {
  title: string;
  description: string;
  locale: Locale;
  /** Route table entry of this page; pages outside the table (404) have no alternates. */
  routeKey?: RouteKey;
  /** Never index this page, whatever the switch says (404). */
  noindex?: boolean;
}

type Props = SeoProps;

const { title, description, locale, routeKey, noindex = false } = Astro.props;

const path = withoutBase(Astro.url.pathname);
const canonical = absoluteUrl(path, Astro.site);
const robots = noindex || !indexable ? 'noindex' : 'index, follow, max-image-preview:large, max-snippet:-1';
const alternates = routeKey
  ? locales.map((alt) => ({ hreflang: localeMeta[alt].lang, href: absoluteUrl(localizedPath(routeKey, alt), Astro.site) }))
  : [];
const graph = noindex
  ? null
  : { '@graph': [websiteNode(Astro.site), webPageNode({ path, name: title, description, locale }, Astro.site)] };
---

<title>{title}</title>
<meta name="description" content={description} />
<meta name="robots" content={robots} />
{!noindex && <link rel="canonical" href={canonical} />}
{
  !noindex &&
    alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)
}
{
  !noindex && routeKey && (
    <link rel="alternate" hreflang="x-default" href={absoluteUrl(localizedPath('home', defaultLocale), Astro.site)} />
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={localeMeta[locale].ogLocale} />
{
  locales
    .filter((alt) => alt !== locale)
    .map((alt) => <meta property="og:locale:alternate" content={localeMeta[alt].ogLocale} />)
}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
{!noindex && <meta property="og:url" content={canonical} />}

{graph && <JsonLd data={graph} />}
